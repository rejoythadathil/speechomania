{
  "pageSize": "A4",
  "pageMargins": [44, 44, 44, 52],
  "info": { "title": <%- json(`${child.name}’s learning report`) %> },
  "watermark": { "text": <%- json(watermark) %>, "opacity": 0.045, "angle": -36, "fontSize": 22, "color": "#136197", "font": "JakartaSemi" },
  "defaultStyle": { "font": "Jakarta", "fontSize": 9.5, "color": "#243142", "lineHeight": 1.25 },
  "styles": {
    "eyebrow": { "font": "JakartaSemi", "fontSize": 7.5, "characterSpacing": 1.6, "color": "#5b6472" },
    "heading": { "font": "Bricolage", "fontSize": 15, "color": "#10324d", "margin": [0, 22, 0, 2] },
    "lead": { "color": "#5b6472", "fontSize": 9, "margin": [0, 0, 0, 10] },
    "tileValue": { "font": "Bricolage", "fontSize": 24, "color": "#136197", "lineHeight": 1 },
    "tileLabel": { "font": "JakartaSemi", "fontSize": 8.5, "color": "#425062", "margin": [0, 4, 0, 0] },
    "cell": { "fontSize": 9.5 },
    "cellMuted": { "fontSize": 9, "color": "#5b6472" },
    "columnHead": { "font": "JakartaSemi", "fontSize": 7.5, "characterSpacing": 1, "color": "#7a8594" }
  },
  "content": [
    { "canvas": [
        { "type": "rect", "x": 0, "y": 0, "w": 595.28, "h": 150, "color": "#136197" },
        { "type": "rect", "x": 0, "y": 146, "w": 595.28, "h": 4, "color": "#1479bb" }
      ], "absolutePosition": { "x": 0, "y": 0 } },
    { "text": "SPEECHOMANIA", "font": "JakartaSemi", "fontSize": 8, "characterSpacing": 2.4, "color": "#bcdcf2", "absolutePosition": { "x": 44, "y": 40 } },
    { "text": <%- json(`${child.name}’s learning report`) %>, "font": "Bricolage", "fontSize": 27, "color": "#ffffff", "absolutePosition": { "x": 44, "y": 56 } },
    { "text": <%- json(`Prepared for ${parent.name} on ${today}`) %>, "fontSize": 9.5, "color": "#d6eaf8", "absolutePosition": { "x": 44, "y": 98 } },
    { "text": "", "margin": [0, 118, 0, 0] },
    {
      "table": {
        "widths": ["*", "*", "*"],
        "body": [[
          { "fillColor": "#eef5fb", "stack": [{ "text": <%- json(String(stars)) %>, "style": "tileValue" }, { "text": "Stars collected", "style": "tileLabel" }] },
          { "fillColor": "#eef5fb", "stack": [{ "text": [{ "text": <%- json(String(played)) %> }, { "text": <%- json(` of ${total}`) %>, "fontSize": 13, "color": "#5b8db5" }], "style": "tileValue" }, { "text": "Games played", "style": "tileLabel" }] },
          { "fillColor": "#eef5fb", "stack": [{ "text": <%- json(String(trophies)) %>, "style": "tileValue" }, { "text": "Trophies won", "style": "tileLabel" }] }
        ]]
      },
      "layout": "tiles"
    }
<% if (levels.length) { %>
    , { "text": "Colour levels", "style": "heading" }
    , { "text": "Games are grouped into colour levels, from violet to red.", "style": "lead" }
    , {
      "table": {
        "widths": [92, 160, "*"],
        "body": [
<% levels.forEach((level, index) => { %>
          <%- index ? ',' : '' %> [
            { "columns": [
                { "width": 9, "canvas": [{ "type": "ellipse", "x": 4, "y": 6.5, "r1": 4, "r2": 4, "color": <%- json(level.colour) %> }] },
                { "width": "*", "text": <%- json(level.name) %>, "font": "JakartaSemi" }
              ], "columnGap": 6 },
            { "margin": [0, 3.5, 0, 0], "canvas": [
                { "type": "rect", "x": 0, "y": 0, "w": 150, "h": 6, "r": 3, "color": "#e7edf3" }
<% if (level.bar) { %>
                , { "type": "rect", "x": 0, "y": 0, "w": <%- json(Math.max(level.bar, 6)) %>, "h": 6, "r": 3, "color": <%- json(level.colour) %> }
<% } %>
              ] },
            { "text": <%- json(`${level.played} of ${level.total} played`) %>, "style": "cellMuted" }
          ]
<% }) %>
        ]
      },
      "layout": "rows"
    }
<% } %>
<% if (groups.length) { %>
    , { "text": "Games", "style": "heading" }
    , { "text": "Every game assigned to this child, with the best score so far.", "style": "lead" }
<% for (const group of groups) { %>
    , {
      "unbreakable": <%- json(group.games.length <= 8) %>,
      "margin": [0, 6, 0, 4],
      "stack": [
        { "columns": [
            { "width": 4, "canvas": [{ "type": "rect", "x": 0, "y": 1, "w": 4, "h": 12, "r": 2, "color": <%- json(group.colour) %> }] },
            { "width": "*", "text": <%- json(group.name) %>, "font": "JakartaSemi", "fontSize": 10, "color": "#10324d" }
          ], "columnGap": 8, "margin": [0, 0, 0, 4] },
        {
          "table": {
            "headerRows": 1,
            "widths": ["*", 70, 100],
            "body": [
              [{ "text": "GAME", "style": "columnHead" }, { "text": "PLAYED", "style": "columnHead" }, { "text": "BEST STARS", "style": "columnHead" }]
<% for (const game of group.games) { %>
              , [
                { "text": <%- json(game.title) %>, "style": "cell" },
                { "text": <%- json(game.times) %>, "style": "cellMuted" },
                { "stack": [
                    { "text": <%- json(game.stars) %>, "style": "cellMuted" }
<% if (game.bar) { %>
                    , { "margin": [0, 2, 0, 0], "canvas": [
                        { "type": "rect", "x": 0, "y": 0, "w": 90, "h": 4, "r": 2, "color": "#e7edf3" },
                        { "type": "rect", "x": 0, "y": 0, "w": <%- json(Math.max(game.bar, 4)) %>, "h": 4, "r": 2, "color": <%- json(group.colour) %> }
                      ] }
<% } %>
                  ] }
              ]
<% } %>
            ]
          },
          "layout": "rows"
        }
      ]
    }
<% } %>
<% } %>
<% if (assessments.length) { %>
    , { "text": "Check-ins", "style": "heading" }
    , { "text": "Short check-ins set by the mentor. Some scores are kept for the mentor only.", "style": "lead" }
    , {
      "table": {
        "headerRows": 1,
        "widths": ["*", 90, 120],
        "body": [
          [{ "text": "CHECK-IN", "style": "columnHead" }, { "text": "STATUS", "style": "columnHead" }, { "text": "RESULT", "style": "columnHead" }]
<% for (const check of assessments) { %>
          , [{ "text": <%- json(check.title) %>, "style": "cell" }, { "text": <%- json(check.status) %>, "style": "cellMuted" }, { "text": <%- json(check.result) %>, "style": "cell" }]
<% } %>
        ]
      },
      "layout": "rows"
    }
<% } %>
<% if (remarks.length) { %>
    , { "text": "Notes from the mentor", "style": "heading" }
    , { "text": "Notes the mentor chose to share with you, newest first.", "style": "lead" }
<% for (const remark of remarks) { %>
    , {
      "unbreakable": true,
      "margin": [0, 0, 0, 8],
      "table": {
        "widths": ["*"],
        "body": [[{ "fillColor": "#f6f9fc", "stack": [
          { "text": <%- json(`${remark.author} · ${remark.date}`) %>, "font": "JakartaSemi", "fontSize": 8, "color": "#5b6472", "margin": [0, 0, 0, 3] },
          { "text": <%- json(remark.body) %> }
        ] }]]
      },
      "layout": "note"
    }
<% } %>
<% } %>
  ]
}
