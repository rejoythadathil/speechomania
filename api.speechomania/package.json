{
  "name": "api.speechomania",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.js",
    "start": "bun server.js",
    "migrate": "bun --bun prisma migrate deploy",
    "seed": "bun seeds/dev.js",
    "lint": "eslint .",
    "test": "bun test",
    "check-env": "bun scripts/check-env.js",
    "prepare": "git config core.hooksPath .githooks",
    "migrate:new": "bun scripts/migration-new.js",
    "migrate:check": "bun --bun prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "migrate:status": "bun --bun prisma migrate status",
    "audio": "bun scripts/lesson-audio.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "hono": "4.13.14",
    "joi": "18.3.0",
    "pino": "10.4.0",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
