APP_ENV=prod
DATABASE_URL=postgres://speechomania_app:REPLACE@pgbouncer:5432/speechomania
DATABASE_OWNER_URL=postgres://speechomania_owner:REPLACE@db:5432/speechomania
DATABASE_POOL_MAX=20
VALKEY_URL=redis://:REPLACE@valkey:6379
FIREBASE_PROJECT_ID=speechomania-prod
CORS_ORIGINS=https://app.speechomania.example
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_MEDIA_BUCKET=speechomania-prod-media
MEDIA_URL_TTL_SECONDS=3600
ELEVENLABS_API_KEY=REPLACE
